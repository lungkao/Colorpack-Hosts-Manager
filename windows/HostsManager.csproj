<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 มีมากับ Windows 10/11 อยู่แล้ว ไม่ต้องติดตั้ง runtime เพิ่ม
       .NET Framework 4.8 ships with Windows 10/11, so the exe runs without installing anything. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>HostsManager</AssemblyName>
    <RootNamespace>HostsManager</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.3.0</Version>
    <Product>Hosts Manager</Product>
    <Description>Edit the hosts file during website migrations, with one-click DNS flush</Description>
    <Copyright>lungkao</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
